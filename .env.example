# Copy to ".env" in the project root. Express reads this file.

# --- XAMPP MySQL / MariaDB ---
# 1) Start "MySQL" in XAMPP Control Panel (default port 3306).
# 2) Open http://localhost/phpmyadmin → New → Database name: janken
#    Collation: utf8mb4_unicode_ci → Create.
# 3) Default XAMPP user is root with no password (set MYSQL_PASSWORD if you added one).

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=janken

PORT=3000

# --- Frontend (Vite): put in .env and restart `npm run dev` after changes ---
# API base URL the browser will call (must match where Express listens).
VITE_API_URL=http://localhost:3000

# If you see EADDRINUSE on 3000, use another port and match both PORT and VITE:
# PORT=3001
# VITE_API_URL=http://localhost:3001

# Comma-separated list — must match the SPA origin in the browser address bar exactly
# (scheme + host + port). Defaults in code include 8080 and 5173 on localhost/127.0.0.1/[::1].
# If you open the app from another machine or port, add it here, e.g.:
# CORS_ORIGIN=http://192.168.1.10:8080,http://localhost:8080
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080

# Must match a row in the `players` table (see server seed). Defaults to Player_404.
# VITE_PLAYER_NAME=Player_404
