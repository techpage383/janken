# Copy to ".env" in the project root (Express + Vite both read it).

# --- MySQL (XAMPP / local MariaDB) ---
# 1) Start MySQL in XAMPP.
# 2) phpMyAdmin → create database: janken (utf8mb4_unicode_ci).
# 3) Default user is often root with no password.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=janken

# Express API port
PORT=3000

# --- React (Vite) ---
# Recommended for study: leave empty so the browser calls /api on :8080
# and Vite proxies to Express (no CORS setup needed in dev).
VITE_API_URL=

# Only if you call Express directly from the browser (no proxy):
# VITE_API_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# Player name (must exist in DB after seed). Default: Player_404
# VITE_PLAYER_NAME=Player_404
